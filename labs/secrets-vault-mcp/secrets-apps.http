@base = http://localhost:5093/api
@repoId = 01a07121-f80c-772a-9871-f2729778723a
@appId = 00000000-0000-0000-0000-000000000000
@settingId = 00000000-0000-0000-0000-000000000000
@targetId = 00000000-0000-0000-0000-000000000000
@dev = 0000a5c1-0000-4000-8000-000000000001
@blue = 0000a5c1-0000-4000-8000-000000000002
@green = 0000a5c1-0000-4000-8000-000000000003

### List the environments apps are deployed to
GET {{base}}/environments

### List the repositories the store holds apps for
GET {{base}}/repos

### Register a repository
POST {{base}}/repos
Content-Type: application/json

{
  "name": "integrations.at",
  "localPath": "D:\\git-projects\\integrations.at",
  "remoteUrl": "https://github.com/alexander-kastil/integrations.at"
}

### List one repository's apps in the dev environment
GET {{base}}/repos/{{repoId}}?environmentId={{dev}}

### List one repository's apps in the green environment
GET {{base}}/repos/{{repoId}}?environmentId={{green}}

### Export a repository's apps and settings for one environment
GET {{base}}/repos/export/{{repoId}}?environmentId={{green}}

### Create an app in a repository
POST {{base}}/apps
Content-Type: application/json

{
  "repoId": "{{repoId}}",
  "name": "secrets-mcp",
  "kind": "mcp"
}

### Read one app's settings in the dev environment
GET {{base}}/apps/{{appId}}?environmentId={{dev}}

### Read the same app's settings in the green environment
GET {{base}}/apps/{{appId}}?environmentId={{green}}

### Point an app at the file it writes in the dev environment
PUT {{base}}/apps/targets/{{appId}}/{{dev}}
Content-Type: application/json

{
  "filePath": "src/secrets-mcp/appsettings.Development.json"
}

### Point the same app at its green deployment file
PUT {{base}}/apps/targets/{{appId}}/{{green}}
Content-Type: application/json

{
  "filePath": "deploy/env/secrets-mcp-green.env.template"
}

### Declare a setting on an app
POST {{base}}/apps/settings/{{appId}}
Content-Type: application/json

{
  "name": "ConnectionStrings:Secrets",
  "isSecret": true,
  "comment": "SQL Server connection for the secrets store.",
  "ordinal": 1
}

### Render one app's file for one environment
GET {{base}}/apps/render/{{appId}}?environmentId={{green}}&filePath=deploy/env/secrets-mcp-green.env.template

### Diff an uploaded file against the store, by key only
POST {{base}}/apps/diff/{{appId}}
Content-Type: application/json

{
  "environmentId": "{{green}}",
  "filePath": "deploy/env/secrets-mcp-green.env.template",
  "content": "ConnectionStrings__Secrets=Server=95.217.181.137,1433;Database=secrets-integrations\nApiKeys__Mcp=secrets-integrations-dev-mcp-key\n"
}

### Import an uploaded file, merging into what the store holds
POST {{base}}/apps/import/{{appId}}
Content-Type: application/json

{
  "environmentId": "{{green}}",
  "filePath": "deploy/env/secrets-mcp-green.env.template",
  "content": "ConnectionStrings__Secrets=Server=95.217.181.137,1433;Database=secrets-integrations\nApiKeys__Mcp=secrets-integrations-dev-mcp-key\n",
  "replace": false
}

### Import and replace this environment's values for that file
POST {{base}}/apps/import/{{appId}}
Content-Type: application/json

{
  "environmentId": "{{blue}}",
  "filePath": "deploy/env/secrets-mcp-blue.env.template",
  "content": "ConnectionStrings__Secrets=Server=95.217.181.137,1433;Database=secrets-integrations\n",
  "replace": true
}

### Set one setting's value in one environment
PUT {{base}}/settings/values/{{settingId}}/{{green}}
Content-Type: application/json

{
  "keyPath": "ConnectionStrings__Secrets",
  "value": "Server=95.217.181.137,1433;Database=secrets-integrations",
  "isPlaceholder": true,
  "targetId": "{{targetId}}"
}

### Delete a setting and its value in every environment
DELETE {{base}}/settings/{{settingId}}

### GitHub connection status
GET {{base}}/repos/github/status

### Start the GitHub device flow
POST {{base}}/repos/github/device/start

### Poll the GitHub device flow
POST {{base}}/repos/github/device/poll
Content-Type: application/json

{
  "deviceCode": ""
}

### List the GitHub repositories available to connect
GET {{base}}/repos/github/available

### Disconnect the stored GitHub connection
POST {{base}}/repos/github/disconnect

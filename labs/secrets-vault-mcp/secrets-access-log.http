@base = http://localhost:5093/api

### List the most recent access-log entries
GET {{base}}/access-log

### Page through the access-log
GET {{base}}/access-log?skip=0&take=50

### Filter by action
GET {{base}}/access-log?action=Write

### Filter by entity type
GET {{base}}/access-log?entityType=Secret

### Combine both filters
GET {{base}}/access-log?action=Read&entityType=Vault

### Filter by user name
GET {{base}}/access-log?userName=claude-agent

### Combine every filter
GET {{base}}/access-log?action=Read&entityType=Vault&userName=claude-agent

### Read the recording setting
GET {{base}}/access-log/settings

### Turn off coding-agent-only recording, log everyone
PUT {{base}}/access-log/settings
Content-Type: application/json

{
  "recordCodingAgentOnly": false
}

### Turn coding-agent-only recording back on
PUT {{base}}/access-log/settings
Content-Type: application/json

{
  "recordCodingAgentOnly": true
}

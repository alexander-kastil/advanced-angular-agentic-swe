    "permissions": {
        "defaultMode": "acceptEdits"
    },
    "enableAllProjectMcpServers": true,
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
